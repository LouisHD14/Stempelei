# Kopiere diese Datei nach .env und passe die Werte an.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Öffentliche Adresse der Website, z. B. https://deine-domain.de
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://stempelei:stempelei@localhost:5432/stempelei
# Nur für Tests: eigene, leere Datenbank. Die Tests löschen ihren Inhalt.
TEST_DATABASE_URL=postgres://stempelei:stempelei@localhost:5432/stempelei_test
# true, wenn die App hinter einem Proxy wie Caddy läuft
TRUST_PROXY=false
LOG_LEVEL=info
# E-Mail-Versand über Brevo: SMTP-Login und SMTP-Schlüssel aus Brevo → SMTP & API.
# Leer lassen in der Entwicklung, dann stehen die Mails mit ihren Links im Log. Im Betrieb Pflicht.
SMTP_URL=
# smtp://DEIN-LOGIN%40smtp-brevo.com:DEIN-SMTP-SCHLUESSEL@smtp-relay.brevo.com:587
MAIL_FROM=Stempelei <hallo@deine-domain.de>

# Apple Wallet (optional, alle Angaben oder keine). Dateien in ./secrets, im Container unter /run/secrets.
APPLE_PASS_TYPE_ID=
# APPLE_PASS_TYPE_ID=pass.de.deine-domain.stempelkarte
APPLE_TEAM_ID=
APPLE_PASS_CERT=
# APPLE_PASS_CERT=/run/secrets/pass-cert.pem
APPLE_PASS_KEY=
# APPLE_PASS_KEY=/run/secrets/pass-key.pem
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=
# APPLE_WWDR_CERT=/run/secrets/wwdr.pem
# Zufälliger Wert, mindestens 32 Zeichen, z. B. openssl rand -base64 48. Nie ändern, sonst passen alte Pässe nicht mehr.
WALLET_SECRET=

# Google Wallet (optional)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_KEY_FILE=
# GOOGLE_WALLET_KEY_FILE=/run/secrets/google-wallet.json
