{
  "name": "stempelei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node build/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec --test-concurrency=1 \"test/**/*.test.ts\"",
    "build:single": "node tools/build-single.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.10",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
